# .env.evolution.example — copy to .env.evolution and fill
# Used by docker-compose.caddy.yml and install.sh --with-evolution
# This file is git-ignored (see .gitignore) — never commit real keys.

# Public domain for Protecta Bode (Caddy will provision TLS)
DOMAIN=protectabode.weareupsyd.com
EVOLUTION_DOMAIN=evolution.protectabode.weareupsyd.com

# Default webhook that makes Evolution talk to Twenty CRM
# Evolution will POST inbound WhatsApp messages here
WEBHOOK_URL=https://protectabode.weareupsyd.com/s/protecta/whatsapp/webhook
WEBHOOK_ENABLED=true
WEBHOOK_BY_EVENTS=false

# Evolution API key — CHANGE THIS! Generate with: openssl rand -hex 16
EVOLUTION_API_KEY=protecta-evolution-key-change-me-please

# Evolution instance name (the bot number)
EVOLUTION_INSTANCE=protecta

# Optional: Evolution API base URL (for scripts)
EVOLUTION_API_URL=http://localhost:8080

# Optional: Twenty CRM port
TWENTY_PORT=2020

# Email for Let's Encrypt
EMAIL=admin@weareupsyd.com
