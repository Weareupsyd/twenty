# Protecta Bode platform environment (copy to .env and fill in)
APP_ENV=sandbox
SECRET_KEY=generate-a-long-random-string
INTERNAL_API_KEY=generate-another-long-random-string
# HMAC signing key shared with the configured payment-provider callback.
PAYMENT_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
POSTGRES_PASSWORD=change-me-db

# Production domain (weareupsyd.com): create the DNS A record first.
# Local/dev defaults keep the 18000-range ports; with the https profile the
# Caddyfile routes protectabode.weareupsyd.com -> portal/api/kyc.
DOMAIN=protectabode.weareupsyd.com
PUBLIC_BASE_URL=https://protectabode.weareupsyd.com
KYC_PUBLIC_URL=https://protectabode.weareupsyd.com/kyc
API_PORT=18000
PORTAL_PORT=18080
KYC_PORT=18081

# Email (SMTP). EMAIL_OUTBOX=stdout logs emails in dev instead of sending.
EMAIL_OUTBOX=stdout
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Protecta Bode <policies@example.com>
EMAIL_ASSET_BASE_URL=

# WhatsApp Business Cloud API bot (inbound /webhook)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=protecta-verify

# Passwordless portal sign-in through Evolution API (backend only; never put keys in the frontend)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# KYC stack (Kabila engine, Protecta-branded). KYC_API_KEY is created on first
# boot of kyc-api via its setup wizard.
KABILA_DB_PASSWORD=kabila-change-me
KABILA_JWT_SECRET=change-me-kabila-jwt
KABILA_API_KEY_SECRET=change-me-kabila-apikey
KABILA_ENCRYPTION_KEY=00000000000000000000000000000000
KABILA_SERVICE_TOKEN=change-me-kabila-service
KYC_API_KEY=

# First-boot platform admin (change the password immediately)
ADMIN_PASSWORD=change-me-admin
