# Optional HTTPS front door for the configured Protecta Bode subdomain.
# The installer offers to build this profile after the core stack is healthy.
# If AgriLink's Caddy already owns ports 80/443 on this VPS, answer "no" and
# merge these route targets into its existing site instead.

{$DOMAIN} {
	encode zstd gzip

	# FastAPI, OpenAPI docs, payment-provider callbacks and partner API.
	@api path /api/* /docs /openapi.json /redoc
	handle @api {
		reverse_proxy api:8000
	}

	# Protecta-branded identity-verification wizard.
	@kyc path /kyc /kyc/*
	handle @kyc {
		reverse_proxy kyc-web:8080
	}

	# Meta WhatsApp Cloud API verification + event callbacks.
	@whatsapp path /webhook
	handle @whatsapp {
		reverse_proxy bot:8011
	}

	# Portal SPA.
	handle {
		reverse_proxy portal:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
