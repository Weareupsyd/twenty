# ─────────────────────────────────────────────────────────────────────────
# AgriLink deployment env for the vendored Kabila verification stack.
# Consumed by the root docker-compose.yml (kyc-db / kyc-engine / kyc-api /
# kyc-web services). Copy the values you need into the repo root .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets (override ALL of these in production; start.sh generates them) ─
KABILA_JWT_SECRET=change-me-kabila-jwt
KABILA_API_KEY_SECRET=change-me-kabila-apikey
KABILA_ENCRYPTION_KEY=change-me-32-chars-please-xx
KABILA_SERVICE_TOKEN=change-me-kabila-service
# The live developer API key created on first boot (see kyc-stack/bootstrap).
# AgriLink's API authenticates to Kabila with this (X-API-Key).
KABILA_API_KEY=

# ── Database (dedicated Postgres container kyc-db) ─
KABILA_DB_NAME=kabila
KABILA_DB_USER=kabila
KABILA_DB_PASSWORD=kabila-change-me

# ── Behaviour ─
# Screening stays OFF: the in-node AML port is disabled and every session is
# created with addons.aml_screening=false. The Python AML service is not
# deployed at all.
AML_TS_PORT=false
# Local filesystem storage for captures (volume kyc-uploads) - no S3.
STORAGE_PROVIDER=local
# Sandbox off: production thresholds for liveness / face match.
SANDBOX_MODE=false
RATE_LIMIT_ENABLED=true
MIGRATIONS_LENIENT=true
