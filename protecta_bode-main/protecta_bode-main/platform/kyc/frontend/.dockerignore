# ─────────────────────────────────────────────────
# Frontend .dockerignore - Docker Image Optimization Skill (§6)
# ─────────────────────────────────────────────────
# Build context is ./frontend. Keep only the source needed for the
# Vite build; everything else stays out of the build context.
# Note: .env.* are excluded here AND stripped in the Dockerfile so
# container builds always use the same-origin API via the nginx proxy.

# Node.js
node_modules
npm-debug.log*

# Build outputs & caches
dist
build
coverage
*.tsbuildinfo
.vercel

# Environment & secrets (never bake into an image)
.env
.env.*
!.env.example

# Design / mockup assets not needed at build or runtime
mockups
mockup-proposals.css

# Docs & repo metadata
*.md

# Logs, temp, IDE & OS noise
logs
*.log
.DS_Store
.idea
.vscode
