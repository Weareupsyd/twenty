# syntax=docker/dockerfile:1.7
# ── AgriLink variant of the Kabila frontend ─────────────────────────────
# Same bundle as the stock image, but:
#   1. built with Vite base /kyc/ so it mounts behind the portal at /kyc/*
#   2. API calls go same-origin to /kyc/api/* (proxied to kyc-api:3001 by
#      nginx.agrilink.conf) - no cross-origin config, no key in the browser
ARG NODE_IMAGE=node:24-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03

FROM ${NODE_IMAGE} AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    for attempt in 1 2 3; do \
      npm ci --no-audit --no-fund && break; \
      status=$?; \
      if [ "$attempt" = "3" ]; then exit "$status"; fi; \
      rm -rf node_modules; \
      sleep $((attempt * 2)); \
    done

ARG VITE_EDITION=community
# Same-origin API under the /kyc mount: the SPA fetches /kyc/api/...
# (code prepends this prefix to paths that already begin with /api/)
ARG VITE_API_URL=/kyc

ENV VITE_EDITION=$VITE_EDITION \
    VITE_API_URL=$VITE_API_URL

COPY . .
RUN rm -f .env.production \
    && npx vite build --base=/kyc/

FROM nginxinc/nginx-unprivileged:stable-alpine-slim@sha256:bcf91d2c73ab64fa1c4ac7fbac5ac523057c8af7d553ab9251c7aef38c260979

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.agrilink.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
