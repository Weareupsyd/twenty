{
  "name": "kabila",
  "version": "1.0.0",
  "description": "Identity verification platform MVP with document processing and face recognition",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "cd backend && npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "setup": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "db:setup": "cd backend && npm run db:setup",
    "db:migrate": "cd backend && npm run migrate",
    "db:repair-webhooks": "cd backend && npm run db:repair-webhooks",
    "db:seed": "cd backend && npm run db:seed"
  },
  "keywords": [
    "identity",
    "verification",
    "kyc",
    "ocr",
    "face-recognition",
    "api"
  ],
  "author": "Kabila Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  },
  "workspaces": ["shared", "backend", "frontend", "engine"]
}
